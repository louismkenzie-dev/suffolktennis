# Copy to .env and fill in real values. Never commit .env — this repo is public.
# All VITE_* vars are exposed in the browser bundle; use only publishable/
# restricted keys here, never service-role or secret keys.

# Supabase — suffolk-tennis (Nullshift org, eu-west-2 / London).
# These three are safe to publish: they ship in the browser bundle either way,
# and all access through them is enforced by Row Level Security.
#
# Use the legacy anon key, not the newer sb_publishable_... one. Several edge
# functions run with verify_jwt enabled and are invoked straight from the
# browser; the anon key is a JWT and satisfies that check, the publishable key
# is not. The same values must also be set in the Vercel project settings —
# Vite inlines them at build time, so a missing value white-screens the app.
VITE_SUPABASE_URL=https://twtmkvorzpvwnznqzcrw.supabase.co
VITE_SUPABASE_PROJECT_ID=twtmkvorzpvwnznqzcrw
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InR3dG1rdm9yenB2d256bnF6Y3J3Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODcwNjU0NzQsImV4cCI6MjEwMjY0MTQ3NH0.e6J1Wp2pypuj6bIOQKFt9WvQlxSDy-QVyW2hcrfqtqE

# Third-party keys — fill in locally, do not commit real values.
VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_BROWSER_KEY=<google-maps-browser-key>
VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_TRACKING_ID=<google-maps-tracking-id>

VITE_MAPBOX_TOKEN=pk.<your-mapbox-public-token>
